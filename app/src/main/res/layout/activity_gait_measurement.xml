<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_blue"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보행 측정"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/tvElderlyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- ─── IDLE 상태 ─── -->
    <LinearLayout
        android:id="@+id/layoutIdle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_walk"
            android:background="@drawable/bg_elderly_avatar"
            android:padding="24dp"
            android:contentDescription="보행 아이콘" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보행 측정 준비"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주머니에 핸드폰을 방향 상관없이\n넣고 잘 고정해주세요.\n\n준비가 되면 아래 측정 시작 버튼을\n누르고 자연스럽게 걸어주세요."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.6" />

        <Button
            android:id="@+id/btnStart"
            style="@style/GaitCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="측정 시작"
            android:textSize="18sp"
            android:layout_marginTop="36dp" />
    </LinearLayout>

    <!-- ─── CALIBRATING 상태 ─── -->
    <LinearLayout
        android:id="@+id/layoutCalibrating"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCalibrationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자세 교정 중..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자연스럽게 걸어주세요.\n축 자동 보정 중입니다."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.5" />

        <ProgressBar
            android:id="@+id/progressCalibration"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="32dp"
            android:progressTint="@color/primary_blue"
            android:progressBackgroundTint="@color/primary_blue_light"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvCalibrationProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="16sp"
            android:textColor="@color/primary_blue"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ─── MEASURING 상태 ─── -->
    <LinearLayout
        android:id="@+id/layoutMeasuring"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <!-- 파동 애니메이션 원 -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal">
            <View
                android:id="@+id/viewWave"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sensor_wave" />
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="00:00"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue" />
        </FrameLayout>

        <!-- 녹화 표시 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FFF44336"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/tvRecordingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="측정 중"
                android:textSize="16sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMinTimeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최소 20초 더 측정"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnStop"
            style="@style/GaitCare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="측정 완료"
            android:textSize="18sp"
            android:layout_marginTop="36dp"
            android:enabled="false"
            android:alpha="0.5" />
    </LinearLayout>

</LinearLayout>
